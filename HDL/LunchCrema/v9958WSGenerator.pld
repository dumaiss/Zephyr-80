Name     LUNCHCREMA_V9958_WAIT_BRIDGE;
PartNo   LC-WAIT-R04;
Date     2026-09-01;
Revision 04;
Designer Kitamura;
Company  Percolated Labs;
Assembly LunchCrema;
Location U11;
Device   G22V10;


/***********************************************************************
 * LunchCrema V9958 WAIT bridge
 *
 * Target:
 *   - Zephyr-80, 10 MHz Z80
 *   - Yamaha V9958
 *   - ATF22V10C-15PU
 *
 * Purpose:
 *
 *   The V9958 native /WAIT output can take too long to assert to
 *   reliably catch the first useful WAIT sampling point of a 10 MHz
 *   Z80.
 *
 *   This PLD therefore:
 *
 *     1. detects /CSR or /CSW immediately;
 *     2. asserts WAIT_SINK combinationally;
 *     3. holds the host in WAIT for at least one complete V9958
 *        CPUCLK period;
 *     4. then hands control to the V9958 native /WAIT output.
 *
 *   WAIT_SINK drives the gate of a 2N7002:
 *
 *       WAIT_SINK = 1  -> MOSFET ON  -> pBITz /WAIT LOW
 *       WAIT_SINK = 0  -> MOSFET OFF -> motherboard pulls /WAIT HIGH
 *
 *
 * Hardware / firmware contract:
 *
 *   V9958 R#25.WTE = 1
 *       Native VDP WAIT support must be enabled during normal use.
 *
 *   V9958 R#25.VDS = 0
 *       Pin 8 must remain CPUCLK.
 *
 *   /WS_EN = 0
 *       External front-porch WAIT generator enabled.
 *
 *   /WS_EN = 1
 *       External porch bypassed; native V9958 /WAIT still passes.
 *
 *   The configuration latch resets /WS_EN low, therefore the porch
 *   is ENABLED by default after system reset.
 *
 *
 * CUPL active-low convention:
 *
 *   Pin 2 = !CSR;
 *
 * means:
 *
 *       physical /CSR LOW -> internal CSR = 1
 *
 * Likewise:
 *
 *       physical /CSW   LOW -> CSW   = 1
 *       physical /WAIT  LOW -> VWAIT = 1
 *       physical /WS_EN LOW -> WS_EN = 1
 *       physical /RESET LOW -> RESET = 1
 *
 **********************************************************************/


/***********************************************************************
 * INPUTS
 **********************************************************************/

/*
 * Pin 1 is the global register clock of the ATF22V10.
 *
 * This comes from V9958 pin 8 CPUCLK.
 * At the normal V9958 crystal frequency it is approximately
 * 3.579545 MHz.
 */

Pin 1 = VDPCLK;


/*
 * These are SENSE connections.
 *
 * The same decoder outputs drive the actual V9958 /CSR and /CSW pins.
 * U11 does not generate those strobes.
 */

Pin 2 = !CSR;
Pin 3 = !CSW;


/*
 * Native V9958 /WAIT, pin 26.
 *
 * It must NOT also be tied directly to the pBITz /WAIT bus.
 */

Pin 4 = !VWAIT;


/*
 * Active-low porch enable.
 *
 * Physical LOW  -> external fast porch enabled.
 * Physical HIGH -> porch bypassed.
 *
 * Native VWAIT remains effective regardless of this input.
 */

Pin 5 = !WS_EN;


/*
 * pBITz system reset.
 */

Pin 6 = !RESET;


/***********************************************************************
 * REGISTERED INTERNAL STATE
 *
 * ATF22V10 has no true buried macrocells, so these use output
 * macrocells whose physical pins are simply left unconnected.
 **********************************************************************/

Pin 23 = PORCH1;
Pin 22 = PORCH2;


/***********************************************************************
 * EXTERNAL OUTPUT
 **********************************************************************/

/*
 * Active-high MOSFET gate drive.
 *
 * Pin 21 -> 2N7002 gate
 * 2N7002 source -> GND
 * 2N7002 drain  -> pBITz /WAIT
 *
 * The motherboard provides the /WAIT pull-up.
 */

Pin 21 = WAIT_SINK;


/***********************************************************************
 * VDP-CLOCKED FRONT PORCH
 **********************************************************************/

/*
 * PORCH1 captures the fact that a VDP transaction is active.
 *
 * Since CSR and CSW are internal active-high assertions:
 *
 *     CSR # CSW
 *
 * means:
 *
 *     physical /CSR LOW OR physical /CSW LOW
 */

PORCH1.d = CSR # CSW;


/*
 * PORCH2 follows PORCH1 one VDPCLK later.
 *
 * Worst phase case:
 *
 *     access begins immediately before VDPCLK edge #1
 *
 *     edge #1:
 *         PORCH1 = 1
 *         PORCH2 = 0
 *
 *     edge #2:
 *         PORCH1 = 1
 *         PORCH2 = 1
 *
 * Therefore the fixed porch cannot disappear until at least one
 * complete VDPCLK interval has elapsed.
 *
 * At ~3.579545 MHz:
 *
 *     1 / 3.579545 MHz ~= 279.4 ns
 *
 * This comfortably exceeds the V9958's native /WAIT assertion
 * latency before native /WAIT is trusted.
 */

PORCH2.d = PORCH1;


/***********************************************************************
 * ASYNCHRONOUS REARM
 **********************************************************************/

/*
 * Both porch registers are cleared whenever neither /CSR nor /CSW
 * is active.
 *
 * This expression is deliberately ONE product term:
 *
 *     !CSR & !CSW
 *
 * The ATF22V10 asynchronous reset resource is global, and WinCUPL
 * will reject a multi-product-term .AR expression.
 *
 * This exact form is known to compile in WinCUPL.
 */

PORCH1.ar = !CSR & !CSW;
PORCH2.ar = !CSR & !CSW;


/*
 * No synchronous preset.
 */

PORCH1.sp = 'b'0;
PORCH2.sp = 'b'0;


/***********************************************************************
 * HOST WAIT GENERATION
 **********************************************************************/

/*
 * WAIT_SINK is asserted only during an active VDP transaction.
 *
 *
 * PHASE 1 - immediate fast catch
 *
 * At the beginning of /CSR or /CSW:
 *
 *     PORCH2 = 0
 *
 * If physical /WS_EN is LOW:
 *
 *     internal WS_EN = 1
 *
 * therefore:
 *
 *     WS_EN & !PORCH2 = 1
 *
 * WAIT_SINK consequently asserts immediately, without waiting for
 * a VDPCLK edge.
 *
 *
 * PHASE 2 - native-WAIT handoff
 *
 * After one complete VDPCLK interval, PORCH2 becomes 1:
 *
 *     WS_EN & !PORCH2 = 0
 *
 * The fixed porch disappears and VWAIT alone determines whether
 * the CPU remains stalled.
 *
 *
 * PHASE 3 - release
 *
 * When the V9958 releases physical /WAIT HIGH:
 *
 *     internal VWAIT = 0
 *
 * WAIT_SINK becomes 0, Q1 turns off, and the motherboard pull-up
 * releases pBITz /WAIT.
 *
 *
 * /WS_EN controls ONLY the external porch.
 *
 * Even with /WS_EN HIGH (porch disabled), native V9958 /WAIT still
 * propagates through the VWAIT term.
 *
 *
 * RESET:
 *
 * Physical /RESET LOW gives internal RESET=1, hence !RESET=0.
 * WAIT_SINK is therefore forcibly inactive during system reset.
 */

WAIT_SINK =
      !RESET
    & (CSR # CSW)
    & (
          (WS_EN & !PORCH2)
        # VWAIT
      );
