Name     Z80_MEM_DECODE;
Partno   008;
Date     2026-10-07;
Revision 13;
Designer Kitamura;
Company  Z80 Project;
Assembly Memory Board;
Location U_MEM_GAL;
Device   g22v10;

/* ---------------------------------------------------------------------------
 * Memory decoder revision 13 (baseline, programmed 2026-10-07): the
 * mode-11 window at 6000h-DFFFh plus the mode-10 far aperture.
 *
 * Board modification: the three banking-latch ROM-page bits D5-D7 are
 * wired to three spare I/O pins of this GAL.  The pins are INPUTS ONLY:
 * the latch drives them and the GAL never drives them, so their
 * output-enable stays permanently off (as revision 12 leaves the same
 * pins).  Pin 21 (!CART_CS, no equation, undriven) is unchanged, and
 * RAM_A16-18 stay on pins 15/16/17.
 *
 * Behaviour (architecture section 36.2):
 *   mode 11  6000h-DFFFh (the window) shows bank 7 - page, 2000h-5FFFh
 *            bank 7, 0000h-1FFFh the bank field, E000h-FFFFh bank 0.
 *   mode 10  page = 0: revision 12 (bank field, E000h-FFFFh bank 0).
 *            page != 0: 8000h-BFFFh (the aperture) shows bank 7 - page;
 *            the rest of the application view is unchanged, so the
 *            program, its stack (below E000h) and 0000h-1FFFh stay mapped.
 *   mode 00, 01  revision 12 whatever the page (CP/M unchanged).
 *
 * P = 0 is revision 12 in every mode, so CP/M and any image that never
 * sets the page field run unchanged; CP/M and the production ZephyrOS ROM
 * both boot on the programmed part.
 *
 * MEM_DECODER_rev13.si carries one vector per mode x region x bank x page
 * (generated by tools/rev13_vectors.py, which proves the P = 0
 * equivalence against revision 12 before writing the file).
 *
 * Fit -- INVERTED POLARITY.  In true polarity this function needs 12
 * product terms on each RAM_A output, over pin 15's 10-term budget.  Its
 * complement needs 9, so each output is written as !RAM_A1x = <cover of
 * the zeros>; the 22V10 output polarity fuse makes the pin carry the true
 * RAM_A1x level.  9/9/9 terms against 10/12/14 (tools/pld_terms.py,
 * variant revision-13, --inverted).  The pin declarations are unchanged
 * (Pin 15 = RAM_A16, active high).
 * ------------------------------------------------------------------------- */

/* Inputs */
Pin 1  = A13;
Pin 2  = A14;
Pin 3  = A15;
Pin 4  = MREQ;        /* Active Low */
Pin 5  = MEM_MODE0;   /* Banking latch D3 */
Pin 6  = MEM_MODE1;   /* Banking latch D4 */
Pin 9  = !WR;          /* Active Low */
Pin 10 = !RD;          /* Active Low */


/* Banking Latch Inputs (Reassigned to free pins) */
Pin 11 = BANK_Q0;
Pin 13 = BANK_Q1;
Pin 14 = BANK_Q2;

/* Banking Latch D5-D7 (board bodge): ROM page field, now the mode-11
   window page field.  Inputs only; the GAL never drives them. */
Pin 18 = PAGE0;       /* Latch D5 */
Pin 19 = PAGE1;       /* Latch D6 */
Pin 20 = PAGE2;       /* Latch D7 */

/* Outputs */
Pin 23 = !SRAM_CS;
Pin 22 = !ROM_CS;
Pin 21 = !CART_CS;

/* RAM Banking Address Lines (To RAM A16-A18) */
Pin 15 = RAM_A16;
Pin 16 = RAM_A17;
Pin 17 = RAM_A18;

/* D4:D3 = 00 ROM read / selected SRAM write; 01 flat selected SRAM;
             10 application/common (+ far aperture); 11 caller/OS/common. */
ROM_READ    = !MEM_MODE1 & !MEM_MODE0;

/* Inverted-polarity minimum form: each equation lists where the RAM
   address bit is LOW.  Read them as: bank-field bit 0 (modes 00/01, mode
   10 outside an open aperture, 0000h-1FFFh in mode 11); E000h-FFFFh in
   modes 10/11 (bank 0); page bit 1 over the open mode-10 aperture
   (8000h-BFFFh) and the mode-11 window (6000h-DFFFh). */

!RAM_A16 = !MEM_MODE0 & !PAGE1 & !PAGE2 & !BANK_Q0
         # !MEM_MODE1 & !BANK_Q0
         # !A15 & !MEM_MODE0 & !BANK_Q0
         # !A13 & !A14 & !A15 & !BANK_Q0
         # A14 & !MEM_MODE0 & !BANK_Q0
         # A13 & A14 & A15 & MEM_MODE1
         # !A14 & A15 & MEM_MODE1 & PAGE0
         # A13 & A14 & MEM_MODE0 & MEM_MODE1 & PAGE0
         # A15 & MEM_MODE0 & MEM_MODE1 & PAGE0;

!RAM_A17 = !MEM_MODE0 & !PAGE0 & !PAGE2 & !BANK_Q1
         # !MEM_MODE1 & !BANK_Q1
         # !A15 & !MEM_MODE0 & !BANK_Q1
         # !A13 & !A14 & !A15 & !BANK_Q1
         # A14 & !MEM_MODE0 & !BANK_Q1
         # A13 & A14 & A15 & MEM_MODE1
         # !A14 & A15 & MEM_MODE1 & PAGE1
         # A13 & A14 & MEM_MODE0 & MEM_MODE1 & PAGE1
         # A15 & MEM_MODE0 & MEM_MODE1 & PAGE1;

!RAM_A18 = !MEM_MODE0 & !PAGE0 & !PAGE1 & !BANK_Q2
         # !MEM_MODE1 & !BANK_Q2
         # !A15 & !MEM_MODE0 & !BANK_Q2
         # !A13 & !A14 & !A15 & !BANK_Q2
         # A14 & !MEM_MODE0 & !BANK_Q2
         # A13 & A14 & A15 & MEM_MODE1
         # !A14 & A15 & MEM_MODE1 & PAGE2
         # A13 & A14 & MEM_MODE0 & MEM_MODE1 & PAGE2
         # A15 & MEM_MODE0 & MEM_MODE1 & PAGE2;

ROM_CS  = !MREQ & RD & ROM_READ;
SRAM_CS = !MREQ & (WR # (RD & !ROM_READ));
