DEFINITION MODULE CTCLow;

(* Private interface used by TIMER.MOD.  These procedures are implemented
   by native FTL CTCLOW.Z80, or by CTCTM2.Z80 for the TM2 build. *)

(* Keep this order: FTL LABEL exports are positional.
   Names also fit the TM2 Microsoft REL six-character limit. *)
PROCEDURE LStart(rate : CARDINAL);
PROCEDURE LStop;
PROCEDURE IsAct(VAR value : CARDINAL);
PROCEDURE Pend(VAR value : CARDINAL);
PROCEDURE Take(VAR value : CARDINAL);
PROCEDURE Over(VAR value : CARDINAL);
PROCEDURE Ints(VAR value : CARDINAL);

END CTCLow.
