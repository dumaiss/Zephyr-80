+
+;   Return Z only when BDOS function 10 is reading the CCP input buffer.
+; Preserves (BC,HL); clobbers (AF,DE). This keeps the quality-of-life keys
+; private to the CCP instead of changing buffered input for applications.
+;
+RDBUFCCP:PUSH   HL
+        LD      HL,(PARAMS)
+        LD      DE,INBUFF
+        XOR     A               ;clear carry for the 16-bit comparison.
+        SBC     HL,DE
+        POP     HL
+        RET
+
+;   Control-L clears the VDrip display, redraws the CCP prompt, then uses the
+; existing retype loop so any characters already entered remain editable.
+;
+RDBUFCLR:CALL   RDBUFCCP
+        LD      A,FF
+        JR      NZ,RDBUF14      ;stock behavior outside the CCP.
+        PUSH    BC
+        CALL    ccp_clear_redraw
+        POP     BC
+        LD      HL,(PARAMS)
+        INC     HL              ;point at the buffer's current-length byte.
+        PUSH    BC
+        JR      RDBUF11
