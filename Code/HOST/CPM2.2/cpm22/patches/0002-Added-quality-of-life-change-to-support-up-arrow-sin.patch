 CNTRLP:  EQU     10H             ;control-p
 CNTRLR:  EQU     12H             ;control-r
 CNTRLS:  EQU     13H             ;control-s
@@ -237,7 +238,7 @@ UPPER:  CP      'a'             ;check for letters in the range of 'a' to 'z'.
 ;
 GETINP: LD      A,(BATCH)       ;if =0, then use console input.
         OR      A
-        JP      Z,GETINP1
+        JR      Z,GETINP1
