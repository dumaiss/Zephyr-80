         PUSH    HL
         CALL    OUTCRLF
         XOR     A               ;and update starting position.
         LD      (STARTING),A
-        JP      RDBUF2
+        JR      RDBUF2
 RDBUF5: CP      CNTRLP          ;control-p?
-        JP      NZ,RDBUF6
+        JR      NZ,RDBUF6
         PUSH    HL              ;yes, flip the print flag filp-flop byte.
         LD      HL,PRTFLAG
         LD      A,1             ;PRTFLAG=1-PRTFLAG
@@ -1557,7 +1578,7 @@ RDBUF5: CP      CNTRLP          ;control-p?
         POP     HL
         JP      RDBUF1
