         DEC     B               ;adjust character count.
-        JP      GETINP3
+        JR      GETINP3
 GETINP4:LD      (HL),A          ;add trailing null.
         LD      HL,INBUFF+2
         LD      (INPOINT),HL    ;reset input line pointer.
@@ -368,7 +369,7 @@ VERIFY1:LD      A,(DE)
         INC     DE
         INC     HL
         DEC     B
-        JP      NZ,VERIFY1
+        JR      NZ,VERIFY1
         RET     
