From 3e1d8be9d60cd897bf4af3ca24c06cc33161aa29 Mon Sep 17 00:00:00 2001
From: Kitamura <sdumais.dumais@gmail.com>
Date: Tue, 1 Sep 2026 11:25:00 -0400
Subject: [PATCH 2/3] Added "quality of life" change to support "up-arrow"
 single history command recall and CTRL-L to clear the screen

---
 src/cpm22.asm | 184 +++++++++++++++++++++++++++++++-------------------
 1 file changed, 115 insertions(+), 69 deletions(-)

diff --git a/src/cpm22.asm b/src/cpm22.asm
index 94bdd09..8d26d8a 100644
--- a/src/cpm22.asm
+++ b/src/cpm22.asm
@@ -29,6 +29,7 @@ TAB:     EQU     09H             ;tab
 LF:      EQU     0AH             ;line feed
 FF:      EQU     0CH             ;form feed
 CR:      EQU     0DH             ;carriage return
