+        OR      A               ;an empty command must not erase one-line history.
+        JR      Z,CMMNDH
+        LD      (NBYTES),A      ;safe while idle; TYPE reinitializes this counter.
+CMMNDH:
         CALL    GETINP          ;get line from user.
