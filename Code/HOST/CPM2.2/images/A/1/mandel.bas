10 REM ASCII MANDELBROT TEST - MBASIC
20 W=64
30 H=24
40 MI=24
50 P$=" .:-=+*#%@"
60 PRINT
70 PRINT "MBASIC ASCII MANDELBROT TEST"
80 PRINT
90 FOR PY=0 TO H-1
100 CY=-1.2+PY*2.4/(H-1)
110 FOR PX=0 TO W-1
120 CX=-2.1+PX*3.2/(W-1)
130 X=0
140 Y=0
150 I=0
160 E=0
170 XX=X*X-Y*Y+CX
180 Y=2*X*Y+CY
190 X=XX
200 I=I+1
210 IF X>2 OR X<-2 OR Y>2 OR Y<-2 THEN E=1
220 IF X*X+Y*Y>4 THEN E=1
230 IF E=0 AND I<MI THEN 170
240 IF I=MI THEN PRINT "@"; ELSE C=INT(I*9/MI)+1:PRINT MID$(P$,C,1);
250 NEXT PX
260 PRINT
270 NEXT PY
280 PRINT
290 PRINT "DONE"
300 END