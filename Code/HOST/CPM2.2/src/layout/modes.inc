; Banking latch: independent SRAM bank, memory mode, and ROM page fields.
RAM_BANK_MASK               = 0x07
MEM_MODE0                   = 0x08
MEM_MODE1                   = 0x10
MEM_MODE_MASK               = 0x18
MEM_MODE_ROM                = 0x00
MEM_MODE_FLAT               = 0x08
MEM_MODE_APPLICATION        = 0x10
MEM_MODE_OS                 = 0x18
ROM_PAGE_MASK               = 0xe0
ROM_PAGE_SHIFT              = 5
