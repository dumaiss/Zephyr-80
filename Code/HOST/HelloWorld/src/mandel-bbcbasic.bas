10 REM ASCII MANDELBROT TEST - BBC BASIC Z80
20 W%=64
30 H%=24
40 MI%=24
50 P$=" .:-=+*#%@"
60 PRINT
70 PRINT "BBC BASIC ASCII MANDELBROT TEST"
80 PRINT
90 FOR PY%=0 TO H%-1
100   CY=-1.2+PY%*2.4/(H%-1)
110   R$=""
120   FOR PX%=0 TO W%-1
130     CX=-2.1+PX%*3.2/(W%-1)
140     X=0
150     Y=0
160     I%=0
170     E%=0
180     REPEAT
190       XX=X*X-Y*Y+CX
200       Y=2*X*Y+CY
210       X=XX
220       I%=I%+1
230       IF X>2 OR X<-2 OR Y>2 OR Y<-2 THEN E%=1
240       IF X*X+Y*Y>4 THEN E%=1
250     UNTIL E%=1 OR I%=MI%
260     IF I%=MI% THEN R$=R$+"@" ELSE C%=INT(I%*9/MI%)+1:R$=R$+MID$(P$,C%,1)
270   NEXT PX%
280   PRINT R$
290 NEXT PY%
300 PRINT
310 PRINT "DONE"
320 END